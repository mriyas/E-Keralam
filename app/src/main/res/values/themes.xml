<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.InfoApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme using the AndroidX SplashScreen API -->
    <style name="Theme.InfoApp.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4ECDC4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.InfoApp</item>
    </style>

</resources>
